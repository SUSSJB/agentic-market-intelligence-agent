# Environment contract for the market-intelligence agent.
# Copy this file to `.env` and fill in the values for your local setup.

# Runtime environment: local | dev | staging | prod
MARKET_INTEL_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR
MARKET_INTEL_LOG_LEVEL=INFO

# Directory where cached market data / model artefacts are stored
MARKET_INTEL_DATA_DIR=./.data

# Default HTTP timeout for outbound requests to public data sources (seconds)
MARKET_INTEL_HTTP_TIMEOUT_SECONDS=10
